{
  "name": "@expgolemclone/pi-accounts",
  "version": "0.53.1",
  "private": true,
  "description": "Pi Accounts with shared OpenAI selection and bounded quota recovery.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/private-files"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "npm --workspace @expgolemclone/pi-private-files run build && node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && npm --workspace @expgolemclone/pi-private-files run typecheck",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@expgolemclone/pi-private-files": "0.1.0",
    "@narumitw/pi-tui-kit": "^0.59.0",
    "eventsource-parser": "^4.1.1",
    "jiti": "^2.7.0",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents": false,
    "koffi": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/expgolemclone/pi-accounts"
  }
}
